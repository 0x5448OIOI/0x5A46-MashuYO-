do
    local aba = P.Tab("Minigames", "◆")
    local sec = aba:Section("Dodgeball", nil, 1)

    if not instalado then
        sec:Info("Dodgeball events not found in this place.", 34)
    else
        sec:Toggle({ Name = "Auto catch", Default = false, Bell = false,
            Keybind = { Key = Enum.KeyCode.K },
            Callback = function(v)
                Q.ligado = v
                if v then avisar("Dodgeball", "Auto catch on", 3) end
            end })
        -- O RAIO fica fixo e oculto: ele acerta bem. MEDIDO, as bolas
        -- pra voce chegavam com Destination a 0.0-2.7 studs e as dos
        -- outros a 15-62, entao 12 separa os dois casos com folga.
        --
        -- O TEMPO fica a mostra, porque e o que voce quer mexer. Baixei
        -- o padrao de 0.12 pra 0.03: quanto MENOR o numero, mais tarde
        -- ele dispara. O 0.12 tinha vindo do seu unico catch na mao (o
        -- clique saiu 133ms antes da bola chegar), mas isso era voce se
        -- antecipando — o script nao precisa dessa margem, ele sabe a
        -- hora exata da chegada pelo Duration.
        -- Da pra ir pro negativo: ai ele dispara DEPOIS da chegada
        -- prevista, caso a janela abra mais tarde do que eu acho.
        sec:Slider({ Name = "Fire before", Min = -0.10, Max = 0.30,
            Default = 0.03, Decimals = 2, Suffix = "s",
            Callback = function(v) Q.antes = v end })

        local painel = sec:Info("...", 34)
        task.spawn(function()
            while souAtual() do
                task.wait(1)
                painel.set(("caught %d   ·   hit %d"):format(Q.pegou, Q.tomou))
            end
        end)
    end
end

