--==================================================================
-- MEDIDO NA MARRA. A primeira versao clicava 60ms depois do indicador
-- nascer e o resultado foi:
--     Hooking durava 1.2s (era 4.2s na sua mao)
--     Minigame durava 0.05s -> o peixe fugia sempre
-- O indicador tem um AnimatedWhiteCircle que encolhe de 1.95 ate ~1.0
-- em meio segundo, e o clique so vale perto do fim. Trocando o tempo
-- fixo por "espera o anel chegar em 1.05":
--     Hooking passou pra 5.56s, 7 de 7 indicadores clicados
--     Minigame sobreviveu
-- Por isso aqui eu nao conto tempo: eu olho o TAMANHO do anel. Assim
-- funciona mesmo se o jogo mudar a velocidade da animacao.
do
    local gui = LP.PlayerGui:FindFirstChild("HookMeter")
    if gui then
        gui.DescendantAdded:Connect(function(d)
            if not souAtual() or not C.autoOn then return end
            if not d:IsA("ImageButton") then return end
            task.spawn(function()
                local nasceu = os.clock()
                -- o anel e criado logo depois do botao
                local anel
                for _ = 1, 25 do
                    if not d.Parent then return end
                    anel = d:FindFirstChild("AnimatedWhiteCircle")
                    if anel then break end
                    task.wait(0.02)
                end
                if not anel then
                    -- sem anel nao da pra cronometrar: clica e torce
                    if clicarBotao(d) then stat.hooks = stat.hooks + 1 end
                    return
                end
                while d.Parent and anel.Parent do
                    if not souAtual() or not C.autoOn then return end
                    if anel.Size.X.Scale <= C.hookAnel then
                        if clicarBotao(d) then
                            stat.hooks = stat.hooks + 1
                            info = ("fisgando %d (anel %.2f em %.2fs)")
                                :format(stat.hooks, anel.Size.X.Scale, os.clock() - nasceu)
                        end
                        return
                    end
                    task.wait()
                end
            end)
        end)
    end
end

--==================================================================
--                   FASE 3 · MINIGAME (CatchIndicator)
--==================================================================
-- A pista tem dois Frame:Target parados no centro e um marcador fino
-- (o Frame mais estreito, ZIndex maior) varrendo. Clico quando a
-- posicao PREVISTA do marcador cair dentro do alvo.
do
    local gui = LP.PlayerGui:FindFirstChild("CatchIndicator")
    local ultimoClique = 0
    local xAnterior, tAnterior = nil, nil

    local function pecas()
        if not gui then return nil end
        local alvo, pista
        for _, d in ipairs(gui:GetDescendants()) do
            if d:IsA("Frame") and d.Name == "Target" then
                pista = d.Parent
                if not alvo or d.Size.X.Scale < alvo.Size.X.Scale then alvo = d end
            end
        end
        if not pista then return nil end
        local marcador
        for _, d in ipairs(pista:GetChildren()) do
            if d:IsA("Frame") and d.Name ~= "Target" then
                if not marcador or d.Size.X.Scale < marcador.Size.X.Scale then marcador = d end
            end
        end
        local botao = gui:FindFirstChildWhichIsA("ImageButton", true)
        if not (alvo and marcador and botao) then return nil end
        return alvo, marcador, botao
    end

    RunService.RenderStepped:Connect(function()
        if not souAtual() or not C.autoOn or not gui then return end
        local alvo, marcador, botao = pecas()
        if not alvo then xAnterior = nil return end

        local agora = os.clock()
        local x = marcador.Position.X.Scale
        local centro = alvo.Position.X.Scale
        local meio = alvo.Size.X.Scale * 0.5

        local vel = 0
        if xAnterior and tAnterior and agora > tAnterior then
            vel = (x - xAnterior) / (agora - tAnterior)
        end
        xAnterior, tAnterior = x, agora

        -- MEDIDO: o alvo verde NAO fica no meio. Os centros que gravei
        -- foram 0.500 0.335 0.586 0.200 0.758 0.800 0.227 ... ele muda
        -- de lugar e de largura a cada rodada. Por isso nada aqui e
        -- numero fixo: leio a posicao e a largura do alvo todo quadro.
        -- MEDIDO tambem: do meu clique ate o jogo julgar passam 3 a 6ms
        -- e o marcador anda 0.006. Adiantar mais que isso joga o clique
        -- pra fora do verde - era o bug da foto.
        local previsto = x + vel * C.lead
        local limite = meio * C.precisao
        if math.abs(previsto - centro) <= limite and (agora - ultimoClique) > 0.30 then
            ultimoClique = agora
            clicarBotao(botao)
            info = ("puxando (alvo em %.2f)"):format(centro)
        end
    end)

    -- contador de PERFECT/MISS: o jogo escreve isso num TextLabel novo
    if gui then
        gui.DescendantAdded:Connect(function(d)
            if not souAtual() then return end
            if not d:IsA("TextLabel") then return end
            task.defer(function()
                local t = tostring(d.Text)
                if t:find("PERFECT") then stat.perfect = stat.perfect + 1
                elseif t:find("MISS") then stat.miss = stat.miss + 1 end
            end)
        end)
    end
end

