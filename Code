--==================================================================
--                     DESENHAR UMA LINHA 2D
--==================================================================
-- Frame nao tem "linha": eu faco a linha girando um Frame fino. O
-- meio dele fica no meio dos dois pontos, o comprimento e a distancia
-- e a rotacao e o angulo entre eles.
local function linha(f, a, b, cor, grossura)
    local dx, dy = b.X - a.X, b.Y - a.Y
    local comp = math.sqrt(dx * dx + dy * dy)
    if comp < 1 then f.Visible = false return end
    f.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
    f.Size = UDim2.fromOffset(comp, grossura)
    f.Rotation = math.deg(math.atan2(dy, dx))
    f.BackgroundColor3 = cor
    f.BackgroundTransparency = 0
    f.Visible = true
end

