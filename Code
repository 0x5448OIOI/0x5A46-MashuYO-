--==================================================================
--                   FASE 3 · MINIGAME (CatchIndicator)
--==================================================================
-- A pista tem dois Frame:Target parados no centro e um marcador fino
-- (o Frame mais estreito, ZIndex maior) varrendo. Clico quando a
-- posicao PREVISTA do marcador cair dentro do alvo.
do
    local gui = LP.PlayerGui:FindFirstChild("CatchIndicator")
    local ultimoClique = 0
    local xAnterior, tAnterior = nil, nil

    local function pecas()
        if not gui then return nil end
        local alvo, pista
        for _, d in ipairs(gui:GetDescendants()) do
            if d:IsA("Frame") and d.Name == "Target" then
                pista = d.Parent
                if not alvo or d.Size.X.Scale < alvo.Size.X.Scale then alvo = d end
            end
        end
        if not pista then return nil end
        local marcador
        for _, d in ipairs(pista:GetChildren()) do
            if d:IsA("Frame") and d.Name ~= "Target" then
                if not marcador or d.Size.X.Scale < marcador.Size.X.Scale then marcador = d end
            end
        end
        local botao = gui:FindFirstChildWhichIsA("ImageButton", true)
        if not (alvo and marcador and botao) then return nil end
        return alvo, marcador, botao
    end

    RunService.RenderStepped:Connect(function()
        if not souAtual() or not C.autoOn or not gui then return end
        local alvo, marcador, botao = pecas()
        if not alvo then xAnterior = nil return end

        local agora = os.clock()
        local x = marcador.Position.X.Scale
        local centro = alvo.Position.X.Scale
        local meio = alvo.Size.X.Scale * 0.5

        local vel = 0
        if xAnterior and tAnterior and agora > tAnterior then
            vel = (x - xAnterior) / (agora - tAnterior)
        end
        xAnterior, tAnterior = x, agora

        -- MEDIDO: o alvo verde NAO fica no meio. Os centros que gravei
        -- foram 0.500 0.335 0.586 0.200 0.758 0.800 0.227 ... ele muda
        -- de lugar e de largura a cada rodada. Por isso nada aqui e
        -- numero fixo: leio a posicao e a largura do alvo todo quadro.
        -- MEDIDO tambem: do meu clique ate o jogo julgar passam 3 a 6ms
        -- e o marcador anda 0.006. Adiantar mais que isso joga o clique
        -- pra fora do verde - era o bug da foto.
        local previsto = x + vel * C.lead
        local limite = meio * C.precisao
        if math.abs(previsto - centro) <= limite and (agora - ultimoClique) > 0.30 then
            ultimoClique = agora
            clicarBotao(botao)
            info = ("puxando (alvo em %.2f)"):format(centro)
        end
    end)

    -- contador de PERFECT/MISS: o jogo escreve isso num TextLabel novo
    if gui then
        gui.DescendantAdded:Connect(function(d)
            if not souAtual() then return end
            if not d:IsA("TextLabel") then return end
            task.defer(function()
                local t = tostring(d.Text)
                if t:find("PERFECT") then stat.perfect = stat.perfect + 1
                elseif t:find("MISS") then stat.miss = stat.miss + 1 end
            end)
        end)
    end
end

--==================================================================
--            FASE 4 · GUARDAR  (peixe E minerio)
--==================================================================
-- Voce disse que o botao da mineracao tem o mesmo nome do da pesca. Eu
-- NAO vi o dialogo da mineracao no registro (a gravacao acabou antes de
-- o minerio quebrar), entao nao chuto qual tela e: procuro em QUALQUER
-- tela do PlayerGui um botao escrito Catch / Collect / Capturar.
-- MEDIDO: o botao e um TextButton com Text = "Catch" (o "Capturar" que
-- voce ve e a traducao do Roblox). Na pesca ele mora em
-- CatchOrReleaseIndicator; na mineracao em PlayerGui.ScreenGui, quatro
-- Frames abaixo.
--
-- E aqui esta o pulo do gato: DescendantAdded NAO serve. Pus um vigia
-- nele e ele registrou ZERO eventos enquanto o dialogo aparecia — a
-- arvore e montada fora e enfiada de uma vez, entao quando o pai entra
-- os filhos ja estavam dentro dele. Por isso aqui e VARREDURA, nao
-- evento: e o unico jeito que nao tem como escapar.
local PALAVRAS_GUARDAR = { "catch", "collect", "capturar", "coletar", "keep", "guardar" }
-- estas eu NUNCA aperto: e o botao vermelho, que joga o item fora
local PALAVRAS_SOLTAR = { "soltar", "release", "drop", "descartar", "jogar fora" }

local function limpo(t)
    if type(t) ~= "string" then return nil end
    return string.lower((t:gsub("<[^>]->", "")))
end
local function bate(t, lista)
    if not t then return false end
    for _, p in ipairs(lista) do
        if string.find(t, p, 1, true) then return true end
    end
    return false
end
-- o texto pode estar no proprio botao OU num TextLabel dentro dele
-- (botao com imagem e rotulo por cima, que e o mais comum nesse jogo)
local function textosDe(d)
    local ts = {}
    local ok, t = pcall(function() return d.Text end)
    if ok then ts[#ts + 1] = limpo(t) end
    for _, f in ipairs(d:GetDescendants()) do
        if f:IsA("TextLabel") or f:IsA("TextButton") then
            local ok2, t2 = pcall(function() return f.Text end)
            if ok2 then ts[#ts + 1] = limpo(t2) end
        end
    end
    return ts
end
local function ehBotaoDeGuardar(d)
    if not (d:IsA("TextButton") or d:IsA("ImageButton")) then return false end
    local ts = textosDe(d)
    -- se qualquer texto dele for de soltar, nao encosto
    for _, t in ipairs(ts) do
        if bate(t, PALAVRAS_SOLTAR) then return false end
    end
    for _, t in ipairs(ts) do
        if bate(t, PALAVRAS_GUARDAR) then return true end
    end
    return false
end

-- telas gigantes que nao vale a pena varrer 5x por segundo
local TELAS_PESADAS = {
    Windows = true, TopbarStandard = true, Main = true, Chat = true,
    EmojiPot = true, PlayersList = true, Hotbar = true,
    MinutesLeaderboardSurfaceGui = true, Backpack = true,
    FishInventoryScreenGui = true,
}

do
    local ultimo = 0
    local function guardou(d)
        ultimo = os.clock()
        apertarPorSinal(d)
        task.wait(0.25)
        if not d.Parent then
            stat.peixes = stat.peixes + 1
            info = "collected"
            if C.mineOn then
                mineAlvoAtual = nil
                statMina.coletas = statMina.coletas + 1
            end
            avisar("Farm", "Captured", 2)
            return true
        end
        return false
    end

    task.spawn(function()
        while souAtual() do
            task.wait(0.2)
            if (C.autoOn or C.mineOn) and C.guardar and os.clock() - ultimo > 0.5 then
                local alvo = nil
                -- 1) caminho rapido pelo NOME da tela. E o mais confiavel:
                --    nao depende do idioma do Roblox nem do texto do botao.
                local tela = LP.PlayerGui:FindFirstChild("CatchOrReleaseIndicator")
                if tela then
                    local candidatos = {}
                    for _, d in ipairs(tela:GetDescendants()) do
                        if (d:IsA("TextButton") or d:IsA("ImageButton"))
                            and d.AbsoluteSize.X > 2 then
                            candidatos[#candidatos + 1] = d
                        end
                    end
                    for _, d in ipairs(candidatos) do
                        if ehBotaoDeGuardar(d) then alvo = d break end
                    end
                    -- so tem dois botoes ali: se eu reconheco o de SOLTAR
                    -- e sobrou exatamente um, o que sobrou e o de guardar
                    if not alvo and #candidatos == 2 then
                        local soltar = nil
                        for _, d in ipairs(candidatos) do
                            for _, t in ipairs(textosDe(d)) do
                                if bate(t, PALAVRAS_SOLTAR) then soltar = d break end
                            end
                        end
                        if soltar then
                            for _, d in ipairs(candidatos) do
                                if d ~= soltar then alvo = d break end
                            end
                        end
                    end
                end
                -- 2) varredura geral (a mineracao nasce em telas com nome
                --    generico, tipo "ScreenGui", entao nao da pra fixar)
                if not alvo then
                    for _, g in ipairs(LP.PlayerGui:GetChildren()) do
                        if (g:IsA("ScreenGui") or g:IsA("BillboardGui"))
                            and not g.Name:find("0x5A46")
                            and not TELAS_PESADAS[g.Name] and g.Enabled then
                            local filhos = g:GetDescendants()
                            -- antes eu cortava em 260 descendentes. Era
                            -- chute meu e podia estar jogando fora a tela
                            -- certa (o ViewportFrame do peixe leva o
                            -- modelo inteiro junto). Subi bem o teto.
                            if #filhos <= 2000 then
                                for _, d in ipairs(filhos) do
                                    if (d:IsA("TextButton") or d:IsA("ImageButton"))
                                        and d.AbsoluteSize.X > 2
                                        and ehBotaoDeGuardar(d) then
                                        alvo = d
                                        break
                                    end
                                end
                            end
                        end
                        if alvo then break end
                    end
                end
                if alvo then guardou(alvo) end
            end
        end
    end)
end

