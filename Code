                local antes = {}
                for k, v in pairs(reg) do antes[k] = v end
                pcall(function() ns[nome].On(function() end) end)
                for k, v in pairs(reg) do
                    if v ~= antes[k] then
                        ids[nome] = k
                        reg[k] = antes[k]
                    end
                end
            end
        end

        if ids.ThrowStarted then
            local originais = {}
            for nome, id in pairs(ids) do
                local orig = reg[id]
                originais[id] = orig
                reg[id] = function(dados, ...)
                    if not souAtual() then
                        -- painel novo carregou: eu saio de cena
                        reg[id] = orig
                        return orig and orig(dados, ...)
                    end
                    if nome == "ThrowStarted" and Q.ligado
                        and type(dados) == "table" and dados.Destination then
                        local hrp = LP.Character
                            and LP.Character:FindFirstChild("HumanoidRootPart")
                        local dest = dados.Destination
                        local pos = (typeof(dest) == "CFrame") and dest.Position or dest
                        local dist = hrp and (pos - hrp.Position).Magnitude or 1e9
                        local dur = tonumber(dados.Duration) or 0
                        if dist <= Q.raio then
                            task.delay(math.max(dur - Q.antes, 0), function()
                                if not (Q.ligado and souAtual()) then return end
                                pcall(function() ns.Parry.Fire(0) end)
                            end)
                        end
                    elseif nome == "CatchStarted" and type(dados) == "table"
                        and dados.Player == LP.Name then
                        Q.pegou = Q.pegou + 1
                    elseif nome == "Hit" and type(dados) == "table"
                        and dados.Player == LP.Name then
                        Q.tomou = Q.tomou + 1
                    end
                    return orig and orig(dados, ...)
                end
            end
            restaurar = function()
                for id, o in pairs(originais) do reg[id] = o end
            end
            instalado = true
        end
    end
end

