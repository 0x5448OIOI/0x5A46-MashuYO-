-- VirtualInputManager: entra pelo mesmo caminho de um clique real.
local function clicarEm(x, y)
    pcall(function()
        VIM:SendMouseButtonEvent(x, y, 0, true,  game, 1)
        task.wait(0.02)
        VIM:SendMouseButtonEvent(x, y, 0, false, game, 1)
    end)
end
local function clicarBotao(b)
    if not b or not b.Parent then return false end
    local p, s = b.AbsolutePosition, b.AbsoluteSize
    if s.X < 2 or s.Y < 2 then return false end   -- ainda nao cresceu
    clicarEm(p.X + s.X / 2, p.Y + s.Y / 2)
    return true
end
-- MEDIDO no botao "Catch" do fim da pescaria: o clique do
-- VirtualInputManager NAO pega nele (31 descendentes antes e depois),
-- mas firesignal no Activated fecha o dialogo na hora (31 -> 0). Os
-- outros dois cliques (fisgada e minigame) funcionam com VIM e ficaram
-- como estao, porque estao comprovados.
-- DOIS DEFEITOS QUE EU ACHEI AQUI:
--
-- 1) Eu passava Enum.UserInputType.MouseButton1 como 1o argumento do
--    Activated. O jogo espera um InputObject ali, nao um Enum. Se o
--    handler dele ler input.UserInputType, quebra e o botao nao faz
--    nada. Quando eu PROVEI que funcionava (31 descendentes -> 0), a
--    chamada era firesignal(btn.Activated), sem argumento. Voltei.
--
-- 2) Eu testava so a global "firesignal". Se o seu executor chamar de
--    outro nome, tudo caia no VirtualInputManager — e o VIM comprovado
--    NAO pega nesse botao. Era exatamente isso: o resto do painel usa
--    VIM e funciona, so o Capturar precisa de sinal.
--    Agora eu procuro os apelidos e, se nao achar nenhum, uso
--    getconnections e chamo a funcao conectada na mao.
local FIRE = firesignal or fire_signal or replicatesignal
local GETCON = getconnections or get_signal_cons
local function dispararSinal(sinal)
    if FIRE and pcall(FIRE, sinal) then return true end
    if GETCON then
        local ok, cons = pcall(GETCON, sinal)
        if ok and type(cons) == "table" and #cons > 0 then
            local feito = false
            for _, c in ipairs(cons) do
                if type(c.Fire) == "function" then
                    if pcall(function() c:Fire() end) then feito = true end
                elseif type(c.Function) == "function" then
                    if pcall(c.Function) then feito = true end
                end
            end
            if feito then return true end
        end
    end
    return false
end
local function apertarPorSinal(b)
    if not b or not b.Parent then return false end
    local ok = dispararSinal(b.MouseButton1Click)
    if dispararSinal(b.Activated) then ok = true end
    if not ok then return clicarBotao(b) end
    return true
end
function segurarMouse(liga)
    local m = LP:GetMouse()
    local x, y = m.X, m.Y
    pcall(function() VIM:SendMouseButtonEvent(x, y, 0, liga, game, 1) end)
    segurando = liga
end

