;(function()
--[[=================================================================
    PLAYER  ·  aba do painel 0x5A46
    -------------------------------------------------------------------
    Tudo aqui e do lado do cliente. Duas consequencias que valem saber:

      - WalkSpeed / JumpPower: muitos jogos resetam isso. Por isso eu
        nao seto uma vez, eu reponho todo frame enquanto estiver ligado.
      - Ragdoll e Spin: sao efeitos locais. Voce ve, os outros podem nao
        ver (depende do que o jogo replica).

    As protecoes (anti fling / anti bang / anti force / anti void) sao
    todas defensivas: elas so apagam coisa que apareceu DENTRO do seu
    personagem e que nao foi voce que criou.
===================================================================]]

local P = getgenv().Painel5A46
if not P then return end
local souAtual = P.souAtual
local win = P.win
local function avisar(t, x, s) P.notify(t, x, s or 3) end

local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS        = game:GetService("UserInputService")
local LP = Players.LocalPlayer

local function char()   return LP.Character end
local function hrp()
    local c = char()
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function hum()
    local c = char()
    return c and c:FindFirstChildWhichIsA("Humanoid")
end

local J = {
    velocidade = 16,   -- WalkSpeed padrao do Roblox
    pulo       = 50,   -- JumpPower padrao
    velOn      = false,
    puloOn     = false,
    noclip     = false,
    antiFling  = false,
    antiBang   = false,
    antiForce  = false,
    antiVoid   = false,
    verInvis   = false,
    ragdoll    = false,
    spin       = false,
    spinVel    = 8,
    fly        = false,
    flyVel     = 1,
    clickTP    = false,
}

local abaJog = P.Tab("Player", "●")

--==================================================================
--                        MOVIMENTO
--==================================================================
do
    local sec = abaJog:Section("Movement", nil, 1)

    sec:Toggle({ Name = "WalkSpeed", Default = false, Bell = false,
        Callback = function(v)
            J.velOn = v
            local h = hum()
            if not v and h then h.WalkSpeed = 16 end
        end })
    sec:Slider({ Name = "Speed", Min = 16, Max = 200, Default = 16,
        Callback = function(v) J.velocidade = v end })

    -- MEDIDO: este jogo usa JumpHeight (UseJumpPower = false,
    -- JumpHeight = 7.2), nao JumpPower. Se eu forcasse UseJumpPower =
    -- true eu trocaria o modelo de pulo do jogo. Entao eu respeito o
    -- modo que estiver e converto quando precisar.
    sec:Toggle({ Name = "Jump", Default = false, Bell = false,
        Callback = function(v)
            J.puloOn = v
            local h = hum()
            if not v and h then
                if h.UseJumpPower then h.JumpPower = 50 else h.JumpHeight = 7.2 end
            end
        end })
    sec:Slider({ Name = "Jump height", Min = 7, Max = 120, Default = 7,
        Callback = function(v) J.pulo = v end })

    -- reponho todo frame: se o jogo resetar, eu volto a por
    RunService.Heartbeat:Connect(function()
        if not souAtual() then return end
        local h = hum()
        if not h then return end
        if J.velOn and h.WalkSpeed ~= J.velocidade then h.WalkSpeed = J.velocidade end
        if J.puloOn then
            if h.UseJumpPower then
                -- altura -> forca:  v = raiz(2 * g * h),  g = 196.2
                local forca = math.sqrt(2 * 196.2 * J.pulo)
                if math.abs(h.JumpPower - forca) > 0.5 then h.JumpPower = forca end
            elseif h.JumpHeight ~= J.pulo then
                h.JumpHeight = J.pulo
            end
        end
    end)

    ---------------------------------------------------------- fly
    -- Isto aqui e o sFLY do Infinite Yield, portado. Fui ler a fonte que
    -- voce mandou e descobri que eu tinha errado o diagnostico: o IY
    -- NAO tem rampa de aceleracao nem inclinacao. Ele faz:
    --   SPEED = 50 quando alguma tecla esta segurada, 0 quando nao.
    --   BV.Velocity = ((cam.LookVector * (F+B))
    --                  + ((cam.CFrame * CFrame.new(L+R, (F+B+Q+E)*0.2, 0).p)
    --                     - cam.CFrame.p)) * SPEED
    --   BG.CFrame = cam.CFrame        -- reto, sem CFrame.Angles
    -- O jeitao bom vem de tres coisas que eu tinha errado:
    --   1) o deslocamento lateral sai de um CFrame RELATIVO a camera, e
    --      nao de RightVector puro — por isso ele acompanha a inclinacao
    --      da camera em vez de deslizar reto;
    --   2) aquele (F+B+Q+E)*0.2 no Y: andar pra frente ja levanta um
    --      pouco conforme o angulo da camera. E o "peso" do voo;
    --   3) sobe/desce e Q e E, com o dobro da forca (*2).
    -- O que eu mantive meu: os nomes "0x5A46_" nas instancias (senao o
    -- Anti force desta aba apaga o proprio voo) e o bind no X.
    -- Detalhe do IY: a velocidade dele e MULTIPLICADOR. iyflyspeed = 1
    -- vira 50 studs/s. Por isso o slider agora vai de 1 a 20, nao em
    -- studs. No IY o multiplicador so entrava quando voce apertava a
    -- tecla; eu aplico no loop, entao mexer no slider vale na hora.
    local bg, bv
    local CONTROL  = { F = 0, B = 0, L = 0, R = 0, Q = 0, E = 0 }
    local lCONTROL = { F = 0, B = 0, L = 0, R = 0, Q = 0, E = 0 }
    local SPEED = 0

    local function limparVoo()
        if bg then bg:Destroy() bg = nil end
        if bv then bv:Destroy() bv = nil end
        SPEED = 0
        for k in pairs(CONTROL) do CONTROL[k] = 0 lCONTROL[k] = 0 end
    end
    local function montarVoo()
        local T = hrp()
        if not T then return false end
        limparVoo()
        bg = Instance.new("BodyGyro")
        bg.Name = "0x5A46_flyGyro"
        bg.P = 9e4
        bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        bg.CFrame = T.CFrame
        bg.Parent = T
        bv = Instance.new("BodyVelocity")
        bv.Name = "0x5A46_flyVel"
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bv.Parent = T
        return true
    end

    sec:Toggle({ Name = "Fly", Default = false, Bell = false,
        Keybind = { Key = Enum.KeyCode.X },
        Callback = function(v)
            J.fly = v
            local h = hum()
            if v then
                if not montarVoo() then J.fly = false return end
                if h then h.PlatformStand = true end
            else
                limparVoo()
                if h then h.PlatformStand = J.ragdoll end
            end
        end })
    sec:Slider({ Name = "Fly speed", Min = 1, Max = 20, Default = 1,
        Decimals = 1, Callback = function(v) J.flyVel = v end })
    sec:Label("W A S D  ·  Q E")

    -- os nomes seguem o IY: a tecla E enche CONTROL.Q e a tecla Q enche
    -- CONTROL.E. Parece trocado, mas e assim na fonte e a conta usa desse
    -- jeito, entao deixei igual pra nao inventar bug.
    local MAPA = {
        [Enum.KeyCode.W] = { "F",  1 },
        [Enum.KeyCode.S] = { "B", -1 },
        [Enum.KeyCode.A] = { "L", -1 },
        [Enum.KeyCode.D] = { "R",  1 },
        [Enum.KeyCode.E] = { "Q",  2 },
        [Enum.KeyCode.Q] = { "E", -2 },
    }
    UIS.InputBegan:Connect(function(i, digitando)
        if digitando or not J.fly then return end
        local m = MAPA[i.KeyCode]
        if m then CONTROL[m[1]] = m[2] end
    end)
    UIS.InputEnded:Connect(function(i)
        local m = MAPA[i.KeyCode]
        if m then CONTROL[m[1]] = 0 end
    end)

    RunService.Heartbeat:Connect(function()
        if not souAtual() or not J.fly then return end
        local T, h = hrp(), hum()
        local camera = workspace.CurrentCamera
        if not (T and camera) then return end
        if not (bg and bg.Parent and bv and bv.Parent) then
            if not montarVoo() then return end
        end
        if h then h.PlatformStand = true end

        local vel = J.flyVel
        local F, B = CONTROL.F * vel, CONTROL.B * vel
        local L, R = CONTROL.L * vel, CONTROL.R * vel
        local Q, E = CONTROL.Q * vel, CONTROL.E * vel
        local mexendo = (L + R) ~= 0 or (F + B) ~= 0 or (Q + E) ~= 0

        if mexendo then
            SPEED = 50
        elseif SPEED ~= 0 then
            SPEED = 0
        end

        if mexendo then
            bv.Velocity = ((camera.CFrame.LookVector * (F + B))
                + ((camera.CFrame * CFrame.new(L + R, (F + B + Q + E) * 0.2, 0).Position)
                   - camera.CFrame.Position)) * SPEED
            lCONTROL.F, lCONTROL.B = CONTROL.F, CONTROL.B
            lCONTROL.L, lCONTROL.R = CONTROL.L, CONTROL.R
            lCONTROL.Q, lCONTROL.E = CONTROL.Q, CONTROL.E
        elseif SPEED ~= 0 then
            local lF, lB = lCONTROL.F * vel, lCONTROL.B * vel
            local lL, lR = lCONTROL.L * vel, lCONTROL.R * vel
            local lQ, lE = lCONTROL.Q * vel, lCONTROL.E * vel
            bv.Velocity = ((camera.CFrame.LookVector * (lF + lB))
                + ((camera.CFrame * CFrame.new(lL + lR, (lF + lB + lQ + lE) * 0.2, 0).Position)
                   - camera.CFrame.Position)) * SPEED
        else
            bv.Velocity = Vector3.new(0, 0, 0)
        end
        bg.CFrame = camera.CFrame
    end)

    LP.CharacterAdded:Connect(function()
        task.wait(0.6)
        if J.fly then
            montarVoo()
            local h = hum()
            if h then h.PlatformStand = true end
        end
    end)

    sec:Toggle({ Name = "Noclip", Default = false, Bell = false,
        Callback = function(v)
            J.noclip = v
            if not v then
                local c = char()
                if c then
                    for _, d in ipairs(c:GetDescendants()) do
                        if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
                            d.CanCollide = true
                        end
                    end
                end
            end
        end })
    RunService.Stepped:Connect(function()
        if not souAtual() or not J.noclip then return end
        local c = char()
        if not c then return end
        for _, d in ipairs(c:GetDescendants()) do
            if d:IsA("BasePart") and d.CanCollide then d.CanCollide = false end
        end
    end)
end

--==================================================================
--                        PROTECOES
--==================================================================
do
    local sec = abaJog:Section("Protection", nil, 2)

    ---------------------------------------------------------- fling
    -- Fling e sempre a mesma receita: alguem empurra uma velocidade
    -- absurda no seu personagem. Entao eu vigio a velocidade e corto
    -- quando passa do que um jogador consegue fazer andando.
    local TETO_GIRO, TETO_VEL = 40, 250
    sec:Toggle({ Name = "Anti fling", Default = false, Bell = false,
        Callback = function(v) J.antiFling = v end })
    RunService.Heartbeat:Connect(function()
        if not souAtual() or not J.antiFling then return end
        local r = hrp()
        if not r then return end
        if r.AssemblyAngularVelocity.Magnitude > TETO_GIRO then
            r.AssemblyAngularVelocity = Vector3.zero
        end
        -- voando sou EU que escrevo a velocidade, entao nao corto a
        -- minha propria (o voo chega a 300 e o teto aqui e 250)
        if not J.fly and r.AssemblyLinearVelocity.Magnitude > TETO_VEL then
            local d = r.AssemblyLinearVelocity.Unit * TETO_VEL
            r.AssemblyLinearVelocity = Vector3.new(d.X, r.AssemblyLinearVelocity.Y, d.Z)
        end
        -- o PlatformStand e legitimo quando eu mesmo liguei (voo/ragdoll)
        local h = hum()
        if h and h.PlatformStand and not J.ragdoll and not J.fly then
            h.PlatformStand = false
        end
    end)

    ---------------------------------------------------------- force
    -- Qualquer "motor" que aparecer dentro de voce e coisa de fora:
    -- voce nao cria BodyVelocity em si mesmo. Apago na hora que nasce.
    local FORCA = {
        BodyVelocity = true, BodyForce = true, BodyGyro = true,
        BodyPosition = true, BodyAngularVelocity = true, BodyThrust = true,
        VectorForce = true, LinearVelocity = true, AngularVelocity = true,
        AlignPosition = true, AlignOrientation = true, Torque = true,
    }
    sec:Toggle({ Name = "Anti force", Default = false, Bell = false,
        Callback = function(v) J.antiForce = v end })

    ---------------------------------------------------------- bang
    -- ATENCAO, isso aqui quase virou um bug feio. Meu primeiro plano era
    -- "apaga toda solda que nascer dentro de voce e nao estava la no
    -- spawn". Fui medir e:
    --   1) este personagem nasce com ZERO junta (o jogo monta o R15 sem
    --      Motor6D visivel), entao TODA solda seria "nova";
    --   2) equipar a vara cria RightGrip no RightHand mais uns 40
    --      BTWeld/Motor6D dentro da propria vara.
    -- Ou seja: eu teria destruido a vara e a picareta toda vez que voce
    -- equipasse, e matado a pescaria inteira.
    -- O que identifica um bang de verdade e outra coisa: uma junta que
    -- liga um pedaco SEU a um pedaco de OUTRO jogador. E so isso que eu
    -- apago. Ferramenta nao encosta nisso.
    local COLA = {
        Weld = true, WeldConstraint = true, ManualWeld = true,
        Motor = true, Motor6D = true, Snap = true,
        BallSocketConstraint = true, HingeConstraint = true,
        Rope = true, RodConstraint = true,
    }
    local function donoDaParte(parte)
        if not parte then return nil end
        local m = parte:FindFirstAncestorOfClass("Model")
        while m do
            local p = Players:GetPlayerFromCharacter(m)
            if p then return p end
            m = m:FindFirstAncestorOfClass("Model")
        end
        return nil
    end
    -- serve pra Weld/Motor6D (Part0/Part1) e pra constraint (Attachment)
    local function pontas(d)
        local a, b = nil, nil
        pcall(function() a, b = d.Part0, d.Part1 end)
        if not a then
            pcall(function()
                a = d.Attachment0 and d.Attachment0.Parent
                b = d.Attachment1 and d.Attachment1.Parent
            end)
        end
        return a, b
    end
    local function ehBang(d)
        if d:FindFirstAncestorWhichIsA("Tool") then return false end
        if d.Name == "RightGrip" or d.Name == "LeftGrip" then return false end
        local a, b = pontas(d)
        local da, db = donoDaParte(a), donoDaParte(b)
        -- so incomoda se juntar VOCE com OUTRA PESSOA
        return (da == LP and db ~= nil and db ~= LP)
            or (db == LP and da ~= nil and da ~= LP)
    end
    sec:Toggle({ Name = "Anti bang", Default = false, Bell = false,
        Callback = function(v) J.antiBang = v end })

    -- a solda pode nascer dentro de voce OU dentro do personagem dele.
    -- Por isso eu olho os dois lados: o meu por evento, e o dos vizinhos
    -- de perto por varredura (bang precisa estar colado).
    local function vigiarMeu(c)
        c.DescendantAdded:Connect(function(d)
            task.defer(function()
                if not d.Parent then return end
                -- "0x5A46_" e coisa minha (o voo). Se eu nao pulasse
                -- isso, o Anti force apagaria o meu proprio BodyGyro.
                if J.antiForce and FORCA[d.ClassName]
                    and not d.Name:find("0x5A46_", 1, true)
                    and not d:FindFirstAncestorWhichIsA("Tool") then
                    pcall(function() d:Destroy() end)
                    avisar("Player", "Blocked a " .. d.ClassName, 3)
                elseif J.antiBang and COLA[d.ClassName] and ehBang(d) then
                    pcall(function() d:Destroy() end)
                    avisar("Player", "Blocked someone welding to you", 3)
                end
            end)
        end)
    end
    if char() then vigiarMeu(char()) end
    LP.CharacterAdded:Connect(function(c) task.wait(0.2) vigiarMeu(c) end)

    task.spawn(function()
        while true do
            task.wait(0.4)
            if souAtual() and J.antiBang then
                local r = hrp()
                if r then
                    for _, p in ipairs(Players:GetPlayers()) do
                        local pc = p ~= LP and p.Character
                        local pr = pc and pc:FindFirstChild("HumanoidRootPart")
                        -- so quem esta colado; bang exige encostar
                        if pr and (pr.Position - r.Position).Magnitude < 20 then
                            for _, d in ipairs(pc:GetDescendants()) do
                                if COLA[d.ClassName] and ehBang(d) then
                                    pcall(function() d:Destroy() end)
                                    avisar("Player", "Blocked " .. p.Name, 3)
                                end
                            end
                        end
                    end
                end
            end
        end
    end)

    ---------------------------------------------------------- void
    -- guardo a ultima posicao boa e devolvo se voce passar do limite
    sec:Toggle({ Name = "Anti void", Default = false, Bell = false,
        Callback = function(v) J.antiVoid = v end })
    local ultimaBoa = nil
    task.spawn(function()
        while souAtual() do
            task.wait(0.5)
            local r, h = hrp(), hum()
            if r and h and h.Health > 0 and r.Position.Y > -50 then
                ultimaBoa = r.CFrame
            end
        end
    end)
    RunService.Heartbeat:Connect(function()
        if not souAtual() or not J.antiVoid then return end
        local r = hrp()
        if not r then return end
        -- o mapa mais fundo que eu medi aqui foi o esgoto, em Y = -12.
        -- Abaixo de -180 nao existe chao nenhum: e queda pro vazio.
        if r.Position.Y < -180 and ultimaBoa then
            pcall(function()
                r.AssemblyLinearVelocity = Vector3.zero
                r.CFrame = ultimaBoa
            end)
            avisar("Player", "Pulled you out of the void", 3)
        end
    end)

    ---------------------------------------------- ver invisivel
    -- Nao mexo na transparencia dos outros (o jogo usa isso pra coisa
    -- legitima). Marco com Highlight so quem sumiu inteiro.
    sec:Toggle({ Name = "Show invisible", Default = false, Bell = false,
        Callback = function(v)
            J.verInvis = v
            if not v then
                for _, p in ipairs(Players:GetPlayers()) do
                    local c = p.Character
                    local m = c and c:FindFirstChild("0x5A46_invis")
                    if m then m:Destroy() end
                end
            end
        end })
    task.spawn(function()
        while true do
            task.wait(1)
            if souAtual() and J.verInvis then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LP and p.Character then
                        local c = p.Character
                        local visivel, total = 0, 0
                        for _, d in ipairs(c:GetChildren()) do
                            if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
                                total = total + 1
                                if d.Transparency < 0.9 then visivel = visivel + 1 end
                            end
                        end
                        local marca = c:FindFirstChild("0x5A46_invis")
                        if total > 0 and visivel == 0 then
                            if not marca then
                                local hl = Instance.new("Highlight")
                                hl.Name = "0x5A46_invis"
                                hl.FillTransparency = 0.6
                                hl.OutlineTransparency = 0
                                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                                hl.Adornee = c
                                hl.Parent = c
                            end
                        elseif marca then
                            marca:Destroy()
                        end
                    end
                end
            end
        end
    end)
end

--==================================================================
--                          BRINQUEDOS
--==================================================================
do
    local sec = abaJog:Section("Fun", nil, 1)

    ---------------------------------------------------------- ragdoll
    -- PlatformStand e o ragdoll "de mentira": desliga o controle do
    -- Humanoid e o corpo cai. E local — pode ser que so voce veja.
    sec:Toggle({ Name = "Ragdoll", Default = false, Bell = false,
        Callback = function(v)
            J.ragdoll = v
            local h = hum()
            if h then h.PlatformStand = v or J.fly end
        end })
    LP.CharacterAdded:Connect(function()
        task.wait(0.5)
        local h = hum()
        if h and J.ragdoll then h.PlatformStand = true end
    end)

    ---------------------------------------------------------- spin
    sec:Toggle({ Name = "Spin", Default = false, Bell = false,
        Callback = function(v) J.spin = v end })
    sec:Slider({ Name = "Spin speed", Min = 1, Max = 40, Default = 8,
        Callback = function(v) J.spinVel = v end })
    local giro = 0
    RunService.Heartbeat:Connect(function(dt)
        if not souAtual() or not J.spin then return end
        local r, h = hrp(), hum()
        if not r then return end
        -- o AutoRotate briga com CFrame manual no mesmo frame, entao
        -- desligo enquanto estiver girando (aprendi isso no Gakuran)
        if h and h.AutoRotate then h.AutoRotate = false end
        giro = giro + dt * J.spinVel
        pcall(function()
            r.CFrame = CFrame.new(r.Position) * CFrame.Angles(0, giro, 0)
        end)
    end)
    -- devolve o AutoRotate quando desligar
    task.spawn(function()
        while true do
            task.wait(0.4)
            if souAtual() and not J.spin then
                local h = hum()
                if h and not h.AutoRotate then h.AutoRotate = true end
            end
        end
    end)
end

--==================================================================
--                          CLICK TP
--==================================================================
do
    local sec = abaJog:Section("Click TP", nil, 2)
    sec:Toggle({ Name = "Click TP", Default = false, Bell = false,
        Callback = function(v) J.clickTP = v end })
    -- fica escrito embaixo, ai nao precisa de notificacao toda vez
    sec:Label("Ctrl + Click")

    -- pedi Ctrl junto de proposito: sem isso todo clique no jogo
    -- (pescar, minerar, apertar botao) viraria teleporte.
    local mouse = LP:GetMouse()
    mouse.Button1Down:Connect(function()
        if not souAtual() or not J.clickTP then return end
        if not (UIS:IsKeyDown(Enum.KeyCode.LeftControl)
             or UIS:IsKeyDown(Enum.KeyCode.RightControl)) then return end
        local r = hrp()
        if not r then return end
        local alvo = mouse.Hit
        if not alvo then return end
        pcall(function()
            r.CFrame = CFrame.new(alvo.Position + Vector3.new(0, 3, 0))
        end)
