-- MEDIDO no jogo, tudo isto:
--   RequestPlayerData().fishingInfo.rods  = LISTA  [i] = {Name, Durability, Casts}
--   RequestPlayerData().mining.pickaxes   = DICIONARIO  [Nome] = {durability}
--   (repare que sao formatos diferentes, e o "d" e maiusculo num e
--    minusculo no outro. Nao da pra tratar os dois igual.)
-- O maximo vem da config:
--   Configuration.Fish.fishingRods[Nome].Durability   (Classic Rod = 75)
--   Configuration.pickaxes -> All[Nome].MaxDurability (Wooden = 75)
-- E existe reparo INDIVIDUAL, nao so o "reparar tudo":
--   Fire("RepairFishingRod", Index)   <- posicao na lista
--   Fire("RepairPickaxe",    Name)    <- pelo nome
-- Por isso da pra fazer o que voce pediu: consertar so a estragada, em
-- vez de pagar pra consertar o inventario inteiro.
--
-- ATENCAO nas unidades: a sua Classic Rod aparece com Durability = 100,
-- mas a config diz que o maximo dela e 75. Ou o jogo guarda a vara em
-- porcentagem, ou a config esta desatualizada — nao sei qual. Entao eu
-- nao confio so na config: uso o MAIOR entre a config e o maior valor
-- que eu ja vi naquela ferramenta. Assim, cheia nunca conta como
-- estragada, que e o erro que gastaria o seu dinheiro a toa.
local maxVisto = {}

local function maxDaVara(nome)
    local m = 0
    pcall(function()
        local F = require(RS.Configuration.Fish)
        local def = F.fishingRods and F.fishingRods[nome]
        if def and tonumber(def.Durability) then m = tonumber(def.Durability) end
    end)
    return m
end
local function maxDaPicareta(nome)
    local m = 0
    pcall(function()
        local pk = require(RS.Configuration.pickaxes)
        local def = pk.GetPickaxe and pk.GetPickaxe(nome)
