    local function ligarNaTela(g)
        g.DescendantAdded:Connect(function(d)
            if not souAtual() then return end
            if not d:IsA("ImageButton") then return end
            vivos[d] = { nasceu = os.clock(), tentativas = 0, ultimo = 0 }
        end)
    end
    local gui = LP.PlayerGui:FindFirstChild("Pickaxe")
    if gui then ligarNaTela(gui) end
    LP.PlayerGui.ChildAdded:Connect(function(g)
        if souAtual() and g.Name == "Pickaxe" then ligarNaTela(g) end
    end)

    -- Um loop so olhando TODOS os indicadores vivos. A quantidade varia
    -- (voce viu 2, 10, 20), entao eles se empilham: se tem mais de um na
    -- tela eu nao espero o anel do mais novo, bato no mais velho na hora.
    RunService.Heartbeat:Connect(function()
        if not souAtual() or not C.mineOn then return end
        local agora = os.clock()

        -- limpa os que ja sairam e acha o mais velho
        local n, maisVelho = 0, nil
        for b, info in pairs(vivos) do
            if not b.Parent then
                vivos[b] = nil
            else
                n = n + 1
                if not maisVelho or info.nasceu < vivos[maisVelho].nasceu then
                    maisVelho = b
                end
            end
        end
        if n == 0 then return end

        for b, info in pairs(vivos) do
            local idade = agora - info.nasceu
            local anel = b:FindFirstChild("AnimatedWhiteCircle")
            local tam = (anel and anel.Parent) and anel.Size.X.Scale or nil
            local hora =
                (tam and tam <= C.mineAnel)          -- chegou no ponto
                or idade >= C.mineTeto                -- teto de seguranca
                or (n > 1 and b == maisVelho)         -- fila: nao deixa acumular
                or (tam == nil and idade >= 0.25)     -- sem anel: nao espera de graca
            -- Insiste ate o botao sumir. O indicador nasce com 0x0 pixel e
            -- cresce, entao a PRIMEIRA tentativa pode cair no vazio - era
            -- por isso que as vezes nao clicava.
            if hora and (agora - info.ultimo) >= 0.08 and info.tentativas < 12 then
                info.ultimo = agora
                info.tentativas = info.tentativas + 1
                -- Alterna os dois caminhos. O VirtualInputManager sozinho
                -- deixava passar um ou outro; o firesignal foi o unico que
                -- funcionou no botao Catch. Tentando os dois em alternancia
                -- nao sobra circulo sem clique.
                if info.tentativas % 2 == 1 then
                    apertarPorSinal(b)
                else
                    clicarBotao(b)
                end
                statMina.golpes = statMina.golpes + 1
                statMina.ultimoCirculo = agora
            end
        end
    end)
end

