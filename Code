-- MEDIDO vendo voce vender na mao. O caminho e:
--   E perto do NPC -> nasce a tela ProximityPromptDialog
--   Mineiro : OptionButton2 = "Ores"      -> OptionButton1 = "Sell All"
--   Pescador: OptionButton2 = "Fish Bag"  -> OptionButton1 = "Sell All"
--   e sai a notificacao "Vendeu tudo na sua mochila!"
-- Acho os botoes PELO TEXTO, nao pelo nome: se o jogo trocar a ordem
-- dos OptionButton, o texto continua sendo o mesmo.
local vendendo = false

-- ACHEI COISA MELHOR. ReliabilityStorage.Functions.RequestPlayerData e
-- uma RemoteFunction de LEITURA e devolve os dois inventarios de
-- verdade: fishingInfo.fishes e mining.ores. Antes eu contava peixe
-- olhando a tela e minerio no dedo (contando o que o script coletou).
-- Agora os dois vem do servidor.
-- Guardo o resultado por alguns segundos pra nao ficar perguntando toda
-- hora — e leitura, mas nao precisa ser em rajada.
local dadosCache, dadosEm = nil, 0
local function dadosDoJogador()
    if dadosCache and os.clock() - dadosEm < 5 then return dadosCache end
    local f = RS:FindFirstChild("ReliabilityStorage")
    f = f and f:FindFirstChild("Functions")
    f = f and f:FindFirstChild("RequestPlayerData")
    if not f then return nil end
    local ok, d = pcall(function() return f:InvokeServer() end)
    if ok and type(d) == "table" then
        dadosCache, dadosEm = d, os.clock()
        return d
    end
    return dadosCache
end
local function quantos(t)
    if type(t) ~= "table" then return 0 end
    local n = 0
    for _ in pairs(t) do n = n + 1 end
    return n
end
local function contarPeixes()
    local d = dadosDoJogador()
    if d and type(d.fishingInfo) == "table" then
        return quantos(d.fishingInfo.fishes)
    end
    -- reserva: conta pela tela, como eu fazia antes
    local fi = LP.PlayerGui:FindFirstChild("FishInventoryScreenGui")
    local grid = fi and fi:FindFirstChild("FishGrid", true)
    if not grid then return 0 end
    local n = 0
    for _, c in ipairs(grid:GetChildren()) do if c:IsA("Frame") then n = n + 1 end end
    return n
end
local function contarMinerios()
    local d = dadosDoJogador()
    if d and type(d.mining) == "table" then
        return quantos(d.mining.ores)
    end
    return statMina.coletas   -- reserva: meu contador caseiro
end

--==================================================================
--   VENDA POR REMOTO  (achado lendo constante, sem hook)
--==================================================================
-- Toda a rede do jogo passa por UM RemoteEvent so:
--   ReplicatedStorage.Modules.Events.RemoteEvent:FireServer(nome, ...)
-- Os nomes que interessam aqui (li nas constantes das funcoes, nao
-- decompilei nada):
--   SellAllFishes            - vende a mochila de peixe inteira
--   SellAllOres              - vende todo o minerio
--   SellFish   <Index>       - vende UM peixe (Interface...DialogSlot)
--   LockFish   <Index>       - tranca/destranca um peixe
--   RepairAllFishingRods / RepairAllPickaxes
--   ConvertAllSilverToGold / ConvertSilverToGold <qtd>
-- Testei o SellAllFishes com o dialogo FECHADO e ele vendeu. Entao a
-- tela nao e necessaria.
-- NAO existe "SellOre" avulso: minerio so tem o vender-tudo. Por isso
-- a quantidade na aba Shop vale so pro peixe.
-- O que eu NAO consegui provar: se o servidor checa distancia do NPC.
-- Por isso toda venda por remoto e CONFERIDA (leio a contagem antes e
-- depois) e, se nao cair, eu caio no caminho antigo de andar ate o NPC.
local function eventos()
    local m = RS:FindFirstChild("Modules")
    m = m and m:FindFirstChild("Events")
    m = m and m:FindFirstChild("RemoteEvent")
    return m
end
local function disparar(nome, ...)
    local ev = eventos()
    if not ev then return false end
    return (pcall(function(...) ev:FireServer(nome, ...) end, ...))
end

-- MEDIDO: um CFrame solto NAO cola. Tive que repetir o set uns 8x pra
-- o personagem realmente ficar la. Era esse o furo do "ir ao NPC".
local function chegarPerto(raiz, alcance)
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not (hrp and raiz) then return nil end
    local volta = hrp.CFrame
    local fim = os.clock() + 3
    while os.clock() < fim do
        pcall(function() hrp.CFrame = raiz.CFrame * CFrame.new(0, 0, 3) end)
        task.wait(0.1)
        hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil end
        if (hrp.Position - raiz.Position).Magnitude <= (alcance or 6) then
            task.wait(0.3)
            return volta
        end
    end
    return nil
end
local function raizDoNpc(nome)
    local npcs = workspace:FindFirstChild("NPCS")
    local npc = npcs and npcs:FindFirstChild(nome)
    if not npc then return nil, nil end
    return npc, (npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart
                 or npc:FindFirstChildWhichIsA("BasePart"))
end
-- MEDIDO: voltar logo depois da ida NAO cola. Se eu teleporto pro NPC e
-- ja mando voltar, o servidor me devolve pro NPC — medi 276 studs fora
-- do lugar. Com 1s de respiro e insistindo ~6s, a posicao assenta e
-- volta certinho (medi distFinal = 0.0). Por isso e lento de proposito.
local function voltarPara(cf)
    if not cf then return false end
    task.wait(1)
    local fim = os.clock() + 6
    while os.clock() < fim do
        local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end
        pcall(function() hrp.CFrame = cf end)
        task.wait(0.15)
        hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if hrp and (hrp.Position - cf.Position).Magnitude <= 6 then
            task.wait(0.4)
            hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if hrp and (hrp.Position - cf.Position).Magnitude <= 8 then return true end
        end
    end
    return false
end

local function botaoComTexto(...)
    local alvos = { ... }
    local dlg = LP.PlayerGui:FindFirstChild("ProximityPromptDialog")
    if not dlg then return nil end
    for _, d in ipairs(dlg:GetDescendants()) do
        if d:IsA("TextButton") then
            local ok, t = pcall(function() return d.Text end)
            if ok and type(t) == "string" then
                local tl = string.lower(t:gsub("<[^>]->", ""))
                for _, alvo in ipairs(alvos) do
                    if string.find(tl, alvo, 1, true) then return d end
                end
            end
        end
    end
    return nil
end
local function esperarBotao(seg, ...)
    local fim = os.clock() + seg
    while os.clock() < fim do
        local b = botaoComTexto(...)
        if b and b.AbsoluteSize.X > 2 then return b end
        task.wait(0.1)
    end
    return nil
end

local function irAoNpc(nome)
    local npc, raizNpc = raizDoNpc(nome)
    if not raizNpc then return nil end
    local voltar = chegarPerto(raizNpc, 6)
    if not voltar then return nil end
    -- MEDIDO: o prompt tem HoldDuration = 1.0. Chamar
    -- fireproximityprompt(p) sem a duracao NAO abre a conversa —
    -- era por isso que o caminho do NPC nao abria nada.
    for _, d in ipairs(npc:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            pcall(function()
                if fireproximityprompt then fireproximityprompt(d, 1) end
            end)
        end
    end
    pcall(function()
        VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(0.08)
        VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end)
    return voltar
end

-- MEDIDO: depois de abrir a Fish Bag / Ores o dialogo tem so 4 botoes
-- (Sell All, Back, X e a janela). Os itens da lista NAO sao botoes: sao
-- quadros escritos "Click to sell" que respondem a clique de mouse. Por
-- isso, pra vender uma quantidade, eu clico neles pela posicao na tela
-- (o mesmo caminho que ja funciona nos circulos da mineracao).
local function listaDeItens()
    local dlg = LP.PlayerGui:FindFirstChild("ProximityPromptDialog")
    if not dlg then return {} end
    local melhor, qtd = nil, 0
    for _, d in ipairs(dlg:GetDescendants()) do
        if d:IsA("ScrollingFrame") then
            local n = 0
            for _, c in ipairs(d:GetChildren()) do
                if c:IsA("Frame") or c:IsA("TextButton") or c:IsA("ImageButton") then n = n + 1 end
            end
            if n > qtd then melhor, qtd = d, n end
        end
    end
    local itens = {}
    if melhor then
        for _, c in ipairs(melhor:GetChildren()) do
            if (c:IsA("Frame") or c:IsA("TextButton") or c:IsA("ImageButton"))
                and c.AbsoluteSize.X > 4 then
                itens[#itens + 1] = c
            end
        end
    end
    return itens
end

-- Tenta vender pelo remoto. Devolve true so se a contagem do SERVIDOR
-- realmente caiu — se nao cair, quem chamou vai pro NPC na marra.
local function venderRemoto(tipo, qtd)
    if not eventos() then return false end
    local contar = (tipo == "ore") and contarMinerios or contarPeixes
    dadosCache = nil
    local antes = contar()
    if antes <= 0 then return false end

    -- MEDIDO: o servidor CHECA DISTANCIA. A 1313 studs os dois remotos
    -- foram ignorados sem erro nenhum; a 4 studs do NPC vendeu na hora.
    -- O que ele NAO exige e o dialogo: vendi com a conversa fechada.
    -- Entao eu so encosto no NPC, disparo e volto. Sem menu, sem clique.
    local _, raiz = raizDoNpc((tipo == "ore") and "Miner" or "Fisherman")
    if not raiz then return false end
    local volta = chegarPerto(raiz, 6)
    if not volta then return false end

    if tipo == "ore" then
        -- minerio nao tem venda avulsa, so o vender-tudo
        disparar("SellAllOres")
    elseif not qtd or qtd >= antes then
        disparar("SellAllFishes")
    else
        -- vende de um em um. Vou sempre no indice 1; se aquele peixe
        -- estiver trancado a contagem nao cai, entao ando pro proximo.
        local idx, vendidos, tentativas = 1, 0, 0
        while vendidos < qtd and tentativas < qtd + 8 do
            tentativas = tentativas + 1
            dadosCache = nil
            local n1 = contar()
            if n1 <= 0 then break end
            disparar("SellFish", idx)
            task.wait(0.35)
            dadosCache = nil
            if contar() < n1 then
                vendidos = vendidos + 1
                idx = 1          -- a lista andou, volto pro comeco
            else
                idx = idx + 1    -- provavelmente trancado, pulo
                if idx > n1 then break end
            end
        end
    end

    task.wait(0.9)
    dadosCache = nil
    local caiu = contar() < antes
    voltarPara(volta)
    return caiu
end

