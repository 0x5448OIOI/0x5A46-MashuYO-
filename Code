--==================================================================
-- A mineracao nao tem maquina de estados nenhuma (nao existe
-- Client.Mining com um Variables como o da pesca). O que existe e uma
-- tela "Pickaxe" que cria os MESMOS indicadores da fisgada:
-- AnimatedWhiteCircle 2.0 · MiddleCircle 0.85 · InnerCircle 0.76.
-- Entao o auto e so acertar o clique de cada um.
-- NAO existe contagem de minerio no cliente (procurei em atributos,
-- leaderstats e telas: so aparece dentro do dialogo do Mineiro). Entao
-- este contador e MEU: conta o que o script coletou desde a ultima
-- venda. O de peixe, esse sim, e lido do jogo (FishGrid).
local statMina = { golpes = 0, m1 = 0, ultimoCirculo = 0, trocas = 0, coletas = 0 }

local function picaretaNaMao()
    local ch = LP.Character
    if not ch then return false end
    for _, d in ipairs(ch:GetChildren()) do
        if d:IsA("Tool") and string.find(string.lower(d.Name), "pick") then return true end
    end
    return false
end
local function picaretaNaMochila()
    for _, d in ipairs(LP.Backpack:GetDescendants()) do
        if d:IsA("Tool") and string.find(string.lower(d.Name), "pick") then return d end
    end
    return nil
end
local toggleMina = nil
local ultimaPicareta = 0
local function pegarPicareta()
    if picaretaNaMao() then return true end
    local p = picaretaNaMochila()
    if not p then return false end
    if os.clock() - ultimaPicareta < 1 then return true end
    ultimaPicareta = os.clock()
    local ch = LP.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    if not hum then return true end
    pcall(function() hum:EquipTool(p) end)
    return true
end
local function desligarSemPicareta()
    if toggleMina then toggleMina:Set(false, true) end
    C.mineOn = false
    salvar()
    avisar("Farm", "No pickaxe in your backpack — auto mine turned off", 5)
end

