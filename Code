-- devolve lista de { chave, nome, dur, max } de tudo que voce tem
local function listarFerramentas(tipo)
    local d = dadosDoJogador()
    local r = {}
    if not d then return r end
    if tipo == "pick" then
        local t = d.mining and d.mining.pickaxes
        if type(t) ~= "table" then return r end
        for nome, item in pairs(t) do
            local dur = tonumber(type(item) == "table" and (item.durability or item.Durability) or item)
            if dur then
                local mx = math.max(maxDaPicareta(nome), maxVisto["p:" .. nome] or 0, dur)
                maxVisto["p:" .. nome] = mx
                r[#r + 1] = { chave = nome, nome = nome, dur = dur, max = mx }
            end
        end
    else
        local t = d.fishingInfo and d.fishingInfo.rods
        if type(t) ~= "table" then return r end
        for i, item in ipairs(t) do
            local nome = type(item) == "table" and tostring(item.Name or "?") or "?"
            local dur = tonumber(type(item) == "table" and (item.Durability or item.durability) or item)
            if dur then
                local mx = math.max(maxDaVara(nome), maxVisto["v:" .. nome] or 0, dur)
                maxVisto["v:" .. nome] = mx
                r[#r + 1] = { chave = i, nome = nome, dur = dur, max = mx }
            end
        end
    end
    return r
end

-- limiar: manual conserta qualquer coisa abaixo do cheio; o automatico
-- so entra quando esta baixo mesmo, senao ele ia correr pro NPC depois
-- de cada lancada (perde 1 de durabilidade -> viagem).
local function precisaReparo(tipo, fracao)
    local lista, quais = listarFerramentas(tipo), {}
    for _, f in ipairs(lista) do
        local ruim
        if fracao then
            ruim = f.max > 0 and (f.dur / f.max) <= fracao
        else
            ruim = f.dur < f.max
        end
        if ruim then quais[#quais + 1] = f end
    end
    return quais
end

local function reparar(tipo, fracao)
    if vendendo then return false end
    local quais = precisaReparo(tipo, fracao)
    if #quais == 0 then return false, "nada estragado" end
    if not eventos() then return false, "sem canal de rede" end

    vendendo = true
    local _, raiz = raizDoNpc(tipo == "pick" and "Miner" or "Fisherman")
    if not raiz then vendendo = false return false, "NPC nao carregado" end
    local volta = chegarPerto(raiz, 6)
    if not volta then vendendo = false return false, "nao cheguei no NPC" end

    for _, f in ipairs(quais) do
        if tipo == "pick" then
            disparar("RepairPickaxe", f.chave)
        else
            disparar("RepairFishingRod", f.chave)
        end
        task.wait(0.4)
    end
    task.wait(0.6)
    dadosCache = nil
    local sobrou = precisaReparo(tipo, fracao)
    local consertou = #quais - #sobrou
    voltarPara(volta)
    vendendo = false
    if consertou > 0 then
        avisar("Shop", ("Repaired %d %s"):format(consertou,
            tipo == "pick" and "pickaxe(s)" or "rod(s)"), 4)
        return true
    end
    return false, "o servidor nao aceitou o reparo"
end

-- qtd = nil ou >= o que tem  ->  usa o Sell All
local function vender(nome, aba, qtd)
    if vendendo then return false end
    vendendo = true

    -- caminho novo primeiro: encosta no NPC e dispara o remoto, sem
    -- abrir menu nenhum. Dentro de pcall porque se isso estourar o
    -- "vendendo" travava em true e a venda automatica morria calada.
    local tipo = (nome == "Miner") and "ore" or "fish"
    local okR, feito = pcall(venderRemoto, tipo, qtd)
    if okR and feito then
        vendendo = false
        avisar("Farm", "Sold your " .. (tipo == "ore" and "ores" or "fish"), 4)
        return true
    end

    local voltar = irAoNpc(nome)
    if not voltar then vendendo = false return false end
    local ok = false
    local b = esperarBotao(3, aba)
    if b then
        apertarPorSinal(b)
        task.wait(1.0)
        local itens = listaDeItens()
        if qtd and #itens > 0 and qtd < #itens then
            -- vende so os primeiros "qtd"
            for i = 1, qtd do
                local it = itens[i]
                if it and it.Parent then
                    local ap, asz = it.AbsolutePosition, it.AbsoluteSize
                    clicarEm(ap.X + asz.X / 2, ap.Y + asz.Y / 2)
                    task.wait(0.25)
                end
            end
            ok = true
        else
            local s = esperarBotao(3, "sell all", "vender tudo")
            if s then
                apertarPorSinal(s)
                task.wait(0.8)
                ok = true
            end
        end
    end
    local x = botaoComTexto("x")
    if x then apertarPorSinal(x) end
    task.wait(0.3)
    voltarPara(voltar)
    vendendo = false
    avisar("Farm", ok and ("Sold your " .. (nome == "Miner" and "ores" or "fish"))
                     or ("Could not sell at the " .. nome), 4)
    return ok
end

