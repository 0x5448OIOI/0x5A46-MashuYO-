        if not (writefile and getcustomasset) then
            diz("Seu executor nao tem writefile/getcustomasset.\nUse um ID do Roblox.")
            return
        end
        local url = entrada
        if not pareceImagemDireta(url) then
            diz("Procurando a imagem na pagina...")
