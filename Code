-- MEDIDO: os minerios nascem como Model com nome de cor (os mesmos de
-- Assets.Mining.Ores: Green, Orange, Pink, Red, Blue) e ficam soltos no
-- workspace, perto dos OreSpawner de Workspace.Ores.
local CORES_MINERIO = { Green = true, Orange = true, Pink = true, Red = true, Blue = true }
pcall(function()
    for _, d in ipairs(RS.Assets.Mining.Ores:GetChildren()) do CORES_MINERIO[d.Name] = true end
end)

local function pontoDe(m)
    if m:IsA("BasePart") then return m.Position end
    if m.PrimaryPart then return m.PrimaryPart.Position end
    local ok, cf = pcall(function() return (m:GetBoundingBox()) end)
    return ok and cf.Position or nil
end

-- minerios que ja renderam nada: ficam de fora por um tempo pra ele nao
-- voltar a bater no mesmo esgotado
local esgotados = {}
local function minerioMaisPerto()
    local raiz = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not raiz then return nil end
    local agora = os.clock()
    for m, ate in pairs(esgotados) do
        if agora > ate or not m.Parent then esgotados[m] = nil end
    end
    local melhor, dist
    for _, d in ipairs(workspace:GetChildren()) do
        if d:IsA("Model") and CORES_MINERIO[d.Name] and not esgotados[d] then
            local p = pontoDe(d)
            if p then
                local dd = (p - raiz.Position).Magnitude
                if not dist or dd < dist then melhor, dist = d, dd end
            end
        end
    end
    local ores = workspace:FindFirstChild("Ores")
    if ores then
        for _, d in ipairs(ores:GetChildren()) do
            if (d:IsA("Model") or d:IsA("BasePart")) and CORES_MINERIO[d.Name]
                and not esgotados[d] then
                local p = pontoDe(d)
                if p then
                    local dd = (p - raiz.Position).Magnitude
                    if not dist or dd < dist then melhor, dist = d, dd end
                end
            end
        end
    end
    return melhor, dist
end

local ultimoTP = 0
local function irAte(minerio)
    local ch = LP.Character
    local raiz = ch and ch:FindFirstChild("HumanoidRootPart")
    local p = minerio and pontoDe(minerio)
    if not raiz or not p then return false end
    if os.clock() - ultimoTP < C.mineEsperaTP then return false end
    ultimoTP = os.clock()
    -- para 4 studs na frente dele, de cara pra ele, na mesma altura
    local dir = (raiz.Position - p)
    dir = Vector3.new(dir.X, 0, dir.Z)
    if dir.Magnitude < 0.1 then dir = Vector3.new(0, 0, 1) end
    local destino = p + dir.Unit * C.mineParar + Vector3.new(0, 2, 0)
    pcall(function() raiz.CFrame = CFrame.lookAt(destino, Vector3.new(p.X, destino.Y, p.Z)) end)
    -- a camera tambem, senao o minerio fica fora da tela e o M1 nao acha
    pcall(function()
        Camera.CFrame = CFrame.lookAt(destino - raiz.CFrame.LookVector * 10
            + Vector3.new(0, 4, 0), p)
    end)
    return true
end

-- onde clicar o M1: em cima do minerio na tela, nao onde o mouse estiver
local function miraNoMinerio(minerio)
    local p = minerio and pontoDe(minerio)
    if not p then return nil end
    local ok, sp = pcall(function() return Camera:WorldToViewportPoint(p) end)
    if not ok or not sp or sp.Z <= 0 then return nil end
    local vp = Camera.ViewportSize
    if sp.X < 0 or sp.Y < 0 or sp.X > vp.X or sp.Y > vp.Y then return nil end
    return sp.X, sp.Y
end

-- Ha indicador na tela AGORA? Pergunto direto pra arvore em vez de
-- manter um sinalizador: com 2, 10 ou 20 circulos aparecendo em
-- sequencia, qualquer flag minha sai de sincronia. Esta e a verdade.
local function temIndicador()
    local g = LP.PlayerGui:FindFirstChild("Pickaxe")
    if not g then return false end
    return g:FindFirstChildWhichIsA("ImageButton", true) ~= nil
end

do
    local vivos = {}      -- [ImageButton] = { nasceu = t, tentativas = n }

    local function ligarNaTela(g)
        g.DescendantAdded:Connect(function(d)
            if not souAtual() then return end
            if not d:IsA("ImageButton") then return end
            vivos[d] = { nasceu = os.clock(), tentativas = 0, ultimo = 0 }
        end)
    end
    local gui = LP.PlayerGui:FindFirstChild("Pickaxe")
    if gui then ligarNaTela(gui) end
    LP.PlayerGui.ChildAdded:Connect(function(g)
        if souAtual() and g.Name == "Pickaxe" then ligarNaTela(g) end
    end)

    -- Um loop so olhando TODOS os indicadores vivos. A quantidade varia
    -- (voce viu 2, 10, 20), entao eles se empilham: se tem mais de um na
    -- tela eu nao espero o anel do mais novo, bato no mais velho na hora.
    RunService.Heartbeat:Connect(function()
        if not souAtual() or not C.mineOn then return end
        local agora = os.clock()

        -- limpa os que ja sairam e acha o mais velho
        local n, maisVelho = 0, nil
        for b, info in pairs(vivos) do
            if not b.Parent then
                vivos[b] = nil
            else
                n = n + 1
                if not maisVelho or info.nasceu < vivos[maisVelho].nasceu then
                    maisVelho = b
                end
            end
        end
        if n == 0 then return end

        for b, info in pairs(vivos) do
            local idade = agora - info.nasceu
            local anel = b:FindFirstChild("AnimatedWhiteCircle")
            local tam = (anel and anel.Parent) and anel.Size.X.Scale or nil
            local hora =
                (tam and tam <= C.mineAnel)          -- chegou no ponto
                or idade >= C.mineTeto                -- teto de seguranca
                or (n > 1 and b == maisVelho)         -- fila: nao deixa acumular
                or (tam == nil and idade >= 0.25)     -- sem anel: nao espera de graca
            -- Insiste ate o botao sumir. O indicador nasce com 0x0 pixel e
            -- cresce, entao a PRIMEIRA tentativa pode cair no vazio - era
            -- por isso que as vezes nao clicava.
            if hora and (agora - info.ultimo) >= 0.08 and info.tentativas < 12 then
                info.ultimo = agora
                info.tentativas = info.tentativas + 1
                -- Alterna os dois caminhos. O VirtualInputManager sozinho
                -- deixava passar um ou outro; o firesignal foi o unico que
                -- funcionou no botao Catch. Tentando os dois em alternancia
                -- nao sobra circulo sem clique.
                if info.tentativas % 2 == 1 then
                    apertarPorSinal(b)
                else
                    clicarBotao(b)
                end
                statMina.golpes = statMina.golpes + 1
                statMina.ultimoCirculo = agora
            end
        end
    end)
end

task.spawn(function()
    while souAtual() do
        task.wait(0.3)
        if C.mineOn and not picaretaNaMao() then
            if not pegarPicareta() then desligarSemPicareta() end
        end
    end
end)

-- O minigame nao aparece sozinho: e preciso ficar batendo M1 no minerio
-- ate ele abrir. Entao o auto bate no ritmo de uma mao normal, e PARA
-- enquanto o indicador esta na tela (la quem clica e o codigo de cima,
-- e um M1 solto no meio so atrapalharia).
task.spawn(function()
    while souAtual() do
        task.wait(C.mineRitmo)
        if C.mineOn and not vendendo and not temIndicador() and picaretaNaMao() then
            -- O sinal de "acabou" NAO e tempo: e o minerio sumir do mapa.
            -- Eu usava 4s sem circulo, mas entre uma rodada de circulos e
            -- a proxima o minerio pede mais M1, e essa pausa passa de 4s.
            -- Resultado: eu largava minerio cheio pela metade.
            if mineAlvoAtual and not mineAlvoAtual.Parent then
                mineAlvoAtual = nil
            end
            -- rede de seguranca: travou de vez, marca como esgotado
            if mineAlvoAtual and statMina.ultimoCirculo > 0
                and os.clock() - statMina.ultimoCirculo > C.mineParado then
                esgotados[mineAlvoAtual] = os.clock() + 30
                mineAlvoAtual = nil
                statMina.trocas = statMina.trocas + 1
            end
            if not mineAlvoAtual then
                mineAlvoAtual = (minerioMaisPerto())
                statMina.ultimoCirculo = os.clock()
                if mineAlvoAtual and C.mineIr then irAte(mineAlvoAtual) end
            end
            local alvo = mineAlvoAtual
            if alvo then
                local raiz = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                local p = pontoDe(alvo)
                local dist = (raiz and p) and (p - raiz.Position).Magnitude or nil
                if C.mineIr and dist and dist > C.mineAlcance then
                    irAte(alvo)
                else
                    local x, y = miraNoMinerio(alvo)
                    if not x then local m = LP:GetMouse() x, y = m.X, m.Y end
                    clicarEm(x, y)
                    statMina.m1 = statMina.m1 + 1
                end
            end
        end
    end
end)

